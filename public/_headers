# Cloudflare Pages Custom Cache & Security Headers
# Reference: https://developers.cloudflare.com/pages/configuration/headers/

# Default security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Fingerprinted static JavaScript and CSS assets from Next.js build
# Filenames include unique content hashes; safe to cache for 1 year
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Search index (~2.76 MB)
# Serves instantly from local browser cache; revalidates in the background if older than 1 hour
/search-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Static media and image assets
/screenshots/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/llms.txt
  Cache-Control: public, max-age=86400
